# Skopiuj do auth.env na serwerze i uzupełnij wygenerowanymi wartościami.
# Nigdy nie wstawiaj hasła ani sekretu TOTP do PHP/JS/HTML.

ADMIN_USER=
ADMIN_PASS_ITERS=310000
ADMIN_PASS_SALT=
ADMIN_PASS_HASH=
ADMIN_TOTP_SECRET=
ADMIN_SESSION_SECRET=
# Lokalny podgląd: 1 pomija kod z aplikacji i wpuszcza samo hasło. Na serwerze zostaw puste.
ADMIN_SKIP_TOTP=
